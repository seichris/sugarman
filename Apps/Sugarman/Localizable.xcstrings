    },
    "privacy.delete_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all local data?"
          }
        }
      }
    },
    "privacy.delete_confirm_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes locally stored sessions and glucose samples from Sugarman. It does not change the physical sensor."
          }
        }
      }
    },
