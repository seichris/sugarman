      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only Bluetooth probe"
          }
        }
      }
    },
    "privacy.probe_disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read-only diagnostic probe is disabled by default and has no characteristic-mutating API. Enable it only on owned hardware after P0."
          }
        }
      }
    },
    "privacy.deletion": {
      "extractionState": "manual",
      "localizations": {
