    "privacy.retention_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session and glucose history stay on this device until you delete them. There is no cloud backend."
          }
        }
      }
    },
    "privacy.no_cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CloudKit and custom cloud sync are off."
          }
        }
      }
    },
    "privacy.diagnostics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
