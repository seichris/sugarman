      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes locally stored sessions, glucose samples, workouts, fueling, and diagnostic logs from Sugarman. It does not change the physical sensor or remove readings already saved in Apple Health."
          }
        }
      }
    },
