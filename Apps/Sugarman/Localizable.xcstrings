{
  "sourceLanguage": "en",
  "strings": {
    "dashboard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live"
          }
        }
      },
      "comment": "Dashboard title"
    },
    "dashboard.no_dosing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugarman is an athlete fueling insight tool. It does not diagnose conditions, recommend treatment, or suggest insulin or medication doses. Never use these readings to dose insulin."
          }
        }
      },
      "comment": "Mandatory no-dosing disclaimer"
    },
    "dashboard.athlete_purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucose monitoring and fueling insight for endurance athletes."
          }
        }
      }
    },
    "dashboard.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection"
          }
        }
      }
    },
