            "value": "Export CSV"
          }
        }
      }
    },
    "privacy.export_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports include schema version, units, timezone, sensor indices, and fueling in JSON. They exclude credentials, account IDs, raw frames, MAC-like IDs, and full serials. CSV is glucose rows only. Diagnostic logs are a separate privacy-safe JSON Lines export."
          }
        }
      }
    },
    "privacy.local_diagnostics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local diagnostics"
          }
        }
      }
