    "dashboard.no_dosing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugarman is an athlete fueling insight tool. It does not diagnose conditions, recommend treatment, or suggest insulin or medication doses. Never use these readings to dose insulin."
          }
        }
      },
      "comment": "Mandatory no-dosing disclaimer"
    },
