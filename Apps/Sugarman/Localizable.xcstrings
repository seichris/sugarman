      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glucose"
          }
        }
      }
    },
    "dashboard.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sensor session. Sugarman has not collected any glucose yet."
          }
        }
      }
    },
    "dashboard.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor disconnected. No current glucose is available."
          }
        }
      }
    },
    "dashboard.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading is stale. Do not treat it as current."
          }
        }
      }
    },
    "dashboard.warmup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor is warming up. No current glucose is available."
          }
        }
      }
    },
    "dashboard.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor reported an error. No current glucose is available."
